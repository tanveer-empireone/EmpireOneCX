# Enable mod_rewrite
RewriteEngine On
RewriteBase /

# Force non-www canonical domain
RewriteCond %{HTTP_HOST} ^www\.empireonecx\.com$ [NC]
RewriteRule ^(.*)$ https://empireonecx.com/$1 [R=301,L]

# Redirect direct .php URLs to clean canonical URLs
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]
# Redirect old location URLs to Global Footprint
RewriteRule ^locations/?$ /global-footprint [R=301,L]
RewriteRule ^locations/(.*)$ /global-footprint/$1 [R=301,L]
RewriteRule ^global-markets/?$ /global-footprint [R=301,L]
RewriteRule ^global-markets/(.*)$ /global-footprint/$1 [R=301,L]
RewriteRule ^global-footprints/?$ /global-footprint [R=301,L]
RewriteRule ^global-footprints/(.*)$ /global-footprint/$1 [R=301,L]
ErrorDocument 404 /404.php

# Serve home.php when root URL is visited
DirectoryIndex home.php index.php

# Remove .php from URLs (Updated to allow subdirectories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]
